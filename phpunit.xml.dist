<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         colors="true"
         bootstrap="./tests/bootstrap.php"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <!--
          The engine suite drives the Zend Engine through z-engine and needs ext-ffi with
          ffi.enable=1.
        -->
        <testsuite name="engine">
            <directory>./tests/</directory>
            <exclude>./tests/PHPStan/</exclude>
        </testsuite>
        <!--
          The analysis suite covers the shipped PHPStan extension. It must run on a host with
          no ext-ffi at all - that is the assertion, not a convenience: an analyser that needed
          the engine to be loadable would be useless in CI and in an IDE.
        -->
        <testsuite name="analysis">
            <directory>./tests/PHPStan/</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Destroys engine state on purpose; run through composer test:internal -->
            <group>internal</group>
            <group>performance</group>
        </exclude>
    </groups>
    <php>
        <!-- Verify FFI struct layouts against the C ground truth on every boot -->
        <env name="ZENGINE_STRICT_LAYOUT_CHECK" value="1"/>
        <!--
          report_memleaks is deliberately OFF, and this is the only place it can be set:
          PHPUnit propagates this block to process-isolated children, so a `-d` on the command
          line is silently overridden by it.

          Copied from z-engine, where it is right and where it gates two dozen scenarios. It is
          wrong here. Almost every test in this package specializes a class, and ClassSpecializer
          documents - in four places - that several of the blocks it allocates through FFI are
          "reclaimed by the request allocator at request end" rather than freed explicitly. Those
          are exactly what the leak reporter counts, so on a debug build this setting fails every
          specializing test with 7-18 "leaks" that are the design working as written. z-engine
          reached the same conclusion first: ClassSpecializerTest is deliberately not in its
          leak-gated group.
        -->
        <ini name="report_memleaks" value="0"/>
    </php>
    <source>
        <include>
            <directory>./src/</directory>
        </include>
    </source>
</phpunit>
